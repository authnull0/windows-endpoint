# AuthNull RADIUS bridge configuration.
#
# Installed to /etc/authnull/radius-bridge.env by install-bridge.sh, owned
# root:freerad 0640. The DIRECTORY must also be group freerad -- see RADIUS.md.
#
# Read fresh on every authentication, so edits take effect on the next login with no
# FreeRADIUS restart.

# ── Required — no defaults ────────────────────────────────────────────────────

# authn-service, NOT authnull-service.
#
# The bridge calls do-authenticationV4 there: that service resolves the user,
# evaluates policy and runs the second factor in one blocking call. Pointing this at
# authnull-service gives HTTP 404 on every login.
#
# In the on-prem compose, authn-service publishes 2882 on the docker host. From a
# FreeRADIUS box on the same machine that is 127.0.0.1:2882; from a separate box it is
# the docker host's address, and the port must be reachable.
API_BASE_URL=http://127.0.0.1:2882

# Your organisation and tenant. Both wrong-by-default is worse than absent, so there is
# no fallback: a mistake here authenticates against another tenant's policies.
ORG_ID=
TENANT_ID=

# Default AD domain for RADIUS users. Used only when User-Name carries no domain of its
# own -- "DOMAIN\user" and "user@realm" both override it, so one FreeRADIUS in front of
# two directories works.
DOMAIN=

# ── Optional ──────────────────────────────────────────────────────────────────

# How long to wait for the user to approve. Push approval is 10-30s of human time.
#
# FIVE timeouts must all be raised or the request dies before the user reaches their
# phone, and it looks like a broken integration rather than a timeout:
#
#   this value                     60   (must stay below rlm_exec timeout)
#   rlm_exec timeout               90   (set by install-bridge.sh)
#   FreeRADIUS max_request_time    90   (set by install-bridge.sh)
#   the appliance's RADIUS timeout  60s+, 1 retry   -- YOU must set this
#   the bridge's HTTP timeout       derived: this + 15s, not configurable
MFA_TIMEOUT_SEC=60

POLL_INTERVAL_SEC=2

# false (the intended posture): an unreachable AuthNull backend DENIES access.
#
# true means a backend outage lets everyone onto the VPN with no second factor. That is
# a deliberate availability-over-security trade, not a convenience -- set it only if
# someone has accepted that in writing.
FAIL_OPEN=false

LOG_PATH=/var/log/authnull/radius-bridge.log

# Normally empty. Sent as X-Authorization when set, for the case where the decision
# route is later put behind auth middleware. HTTP 401 in the log means that happened.
AGENT_TOKEN=

# Reserved. Licensing must never gate a RADIUS login: a licence lapse takes the console
# read-only and leaves the data plane alone.
LICENSE_PATH=/etc/authnull/license.key
