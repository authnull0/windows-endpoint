[Unit]
Description=AuthNull AAA server (RADIUS + TACACS+)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=authnull-aaa
Group=authnull-aaa
# TACACS+ port 49 (TCP) is below 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/local/bin/authnull-aaa --env /etc/authnull/app.env --config /etc/authnull/aaa.yml
# Reloads aaa.yml (clients, upstreams). app.env changes need a restart.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
# SIGTERM waits for logins in progress: MFA_TIMEOUT_SEC (max 70) + 5 s.
TimeoutStopSec=80

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/authnull-aaa /var/log/authnull-aaa

[Install]
WantedBy=multi-user.target
