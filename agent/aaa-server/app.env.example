# AuthNull AAA server settings. Copy to /etc/authnull/app.env (root:authnull-aaa 0640) and fill in,
# then: sudo bash install.sh ./app.env      Changes later need: systemctl restart authnull-aaa

# ── Required — no defaults ────────────────────────────────────────────────────

# authn-service, NOT authnull-service (it makes the login decision). In the on-prem compose it
# publishes 2882 on the docker host.
API_BASE_URL=http://127.0.0.1:2882

# Your organisation and tenant ids. No fallback: a mistake here authenticates against another tenant.
ORG_ID=
TENANT_ID=

# ── Recommended ───────────────────────────────────────────────────────────────

# The id CreateServer returned (type "authnull"). Names this server on every login and turns on
# the heartbeat; without it the console cannot show its health.
RADIUS_SERVER_ID=

# Where heartbeats, login events and accounting go. Empty: authnull-service on API_BASE_URL's
# host, port 8080. REQUIRED when API_BASE_URL is https or port 8080 is not reachable, e.g.
# https://<console>/api/v1/radius/heartbeat -- otherwise everything queues on disk.
HEARTBEAT_URL=

# ── Optional ──────────────────────────────────────────────────────────────────

# Default directory domain for a username that carries none. Empty: AuthNull looks up each user's own.
DOMAIN=

# How long to wait for the user to approve, 1-70 seconds.
MFA_TIMEOUT_SEC=60

# false: an unreachable AuthNull backend rejects the login. true lets a login through without a
# second factor during an outage (not for a code being answered) -- only if accepted in writing.
FAIL_OPEN=false

# Normally empty. Sent as X-Authorization when set.
AGENT_TOKEN=

# LOG_PATH is not read by authnull-aaa; the log file is log_path in aaa.yml.
