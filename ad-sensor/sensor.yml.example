# Authnull DC Sensor — Configuration
#
# Prefer the sensor.yml downloaded from the Authnull console (Identity Providers → your
# directory → Install DC Sensor): it is filled in for the directory and carries this DC's
# sensor credential. This file documents the keys for a hand-written config.
# Location on the DC: C:\ProgramData\Authnull\sensor.yml

# ── Backend ────────────────────────────────────────────────────────────────────
# authn-service decides every sign-in (policy, bypass and push in one call). Use https://:
# the sensor does not follow redirects, so an http:// URL is reported as an error.
authn_service_url: "https://prod.api.authnull.com"
# User sync, audit events and the heartbeat that shows the sensor Active in the console.
ad_service_url: "https://prod.api.authnull.com"

# Obtain tenant_id and org_id from the Authnull console
tenant_id: 1
org_id: 0

# Default AD domain FQDN — used when auth events don't include a domain name
default_domain: "yourdomain.local"

# ── Sensor credential ──────────────────────────────────────────────────────────
# Issued per domain controller by the console download. Exchanged for a short-lived token sent
# on calls to ad_service_url. Keep this file readable only by the sensor's service account.
sensor_token_url: ""
sensor_client_id: ""
sensor_client_secret: ""

# ── AD Sync ────────────────────────────────────────────────────────────────────
ad_sync_enabled: true

# Directory ID from the Authnull console (Identity Providers → your directory)
ad_sync_domain_id: 0

# LDAP base DN for user sync — matches your AD structure
ad_sync_base_dn: "DC=yourdomain,DC=local"

# Only sync users who are members of these groups (leave empty to sync all users)
ad_sync_filter_groups: []

# Only sync users in these OUs (leave empty to sync all OUs)
ad_sync_filter_ous: []

# ── Interception ───────────────────────────────────────────────────────────────
# Holds Kerberos and NTLM-over-SMB sign-ins until the policy decision.
# Needs WinDivert.dll + WinDivert64.sys next to the sensor binary (install.ps1 fetches them).
windivert_enabled: true
windivert_ipv6_enabled: true

# Windows Filtering Platform: blocks NTLM fallback ports while a push is pending.
wfp_enabled: true

# Service tickets held for a decision even when the user already has a TGT.
# "termsrv/*" covers RDP between domain machines. The policy decides who is challenged.
tgs_protected_spns:
  - "termsrv/*"

# ── Netlogon (NTLM pass-through) ─────────────────────────────────────────────────
# Closes the gap where a member server validates a user's NTLM credentials against the DC over
# the Netlogon secure channel (the path Kerberos/SMB interception never sees — e.g. RDP or WinRM
# from a non-domain machine). Requires windivert_enabled: true.
#   ""/"off"         disabled (default)
#   "observe-logons" decrypt + log the logon identity, no blocking
#   "enforce"        hold the SamLogon, run MFA, release on allow / reset on deny
netlogon_mode: ""

# TCP port(s) the DC's Netlogon RPC endpoint listens on. Netlogon uses a dynamic port by
# default; pin it to a static port and list it here (observe-logons/enforce need this). Pin with
# HKLM\SYSTEM\CurrentControlSet\Services\Netlogon\Parameters\DCTcpipPort (DWORD) + reboot.
# Empty = Netlogon capture off.
netlogon_rpc_ports: []

# Decrypt sealed Netlogon SamLogon bodies so the real logon identity drives the MFA decision
# (modern Netlogon always seals). Path to a file of machine-account NT hashes, one per line:
#   ACCOUNT=NThashHex    e.g.  MEMBER01$=31d6cfe0d16ae931b73c59d7e0c089c0
# Empty = no decryption; sealed logons fall back to the 4776 event-log path.
# TIER-0 SECRET: restrict this file to the sensor service account and audit access.
netlogon_machine_key_file: ""

# Debug only: dump parsed Netlogon PDUs to <prefix>.hexlog / <prefix>.pcap for troubleshooting.
# Leave empty in production (the pcap holds raw authentication PDUs).
netlogon_debug_dump_path: ""

# ── Enforcement ────────────────────────────────────────────────────────────────
# The sensor enforces whatever the policies in the console say.
mode: "enforce"

# How long an approval is reused for a policy whose MFA frequency is "every time": just the
# follow-up requests of one sign-in. Policies with "every N minutes" use their own window.
allow_deduplication_window_ms: 15000

# One-push-per-sign-in window (ms). A single interactive/RDP sign-in fires several auth events
# with different source identities (NTLM source IP, event-log workstation name) and protocols
# (Kerberos, NTLM, Netlogon). The first verdict for a user is reused for all of them within this
# window, so the user is prompted once per sign-in instead of several times. Default 20000 (20s).
signin_dedup_window_ms: 20000

# What to do if Authnull cannot be reached: "deny" refuses the sign-in, "allow" lets it in
# without MFA.
fallback_action: "deny"

# ── Logging ────────────────────────────────────────────────────────────────────
log_file: "C:\\ProgramData\\Authnull\\sensor.log"
