# AuthNull SSH proxy configuration.
#
# Installed to /etc/authnull/sshproxy/sshproxy.env by install-sshproxy.sh, owned
# root:authnull 0640. Read once at start, so edits need a restart:
#   sudo systemctl restart authnull-sshproxy
#
# Required values are deliberately blank. The proxy refuses to start rather than
# guessing, and names the variable to fix.

# ── Required ─────────────────────────────────────────────────────────────────

SSHPROXY_ENABLED=true

# authn-service, NOT authnull-service.
#
# The proxy calls do-authenticationV4 there: that service resolves the person
# from the offered key, evaluates policy and runs the second factor in one
# blocking call. Pointing this at authnull-service gives HTTP 404 on every
# session, which the proxy reports as a decision failure and refuses.
#
# The path is SERVER_BASEPATH + /api/v1/authn/v3/do-authenticationV4. With the
# usual basepath of /authnz that is the value below. From a jump host on the
# same machine as the stack this is 127.0.0.1:2882; from a separate box it is
# the docker host's address, and the port must be reachable.
SSHPROXY_AUTHN_URL=http://127.0.0.1:2882/authnz/api/v1/authn/v3/do-authenticationV4

# The organisation this proxy serves. A raw TCP listener carries no request
# body, so there is nothing to derive it from per connection.
SSHPROXY_ORG_ID=

# The tenant. NOT derivable from the organisation: did.tenants has no unique
# constraint on organization_id and the product counts tenants per org, so the
# mapping is one-to-many by design. Use the tenant push MFA already uses for
# this org, or SSH challenges land in a namespace the console's MFA activity
# view does not show.
SSHPROXY_TENANT_ID=

# Optional local limit on which targets this proxy will bridge to, comma
# separated. EMPTY MEANS NO LOCAL LIMIT: policy grants are the gate -- a session
# reaches only a host and account a policy names, through this gateway, with the
# grant key the control plane releases. Set it to keep this gateway inside a
# known segment even if the control plane were compromised. An entry with no
# port matches that host on any port; an entry with a port must match exactly.
SSHPROXY_BACKEND_ALLOWLIST=

# ── Recommended ──────────────────────────────────────────────────────────────

# Signs session recordings so later tampering is detectable. Generated by
# install-sshproxy.sh. Without it recordings are written with no sidecar.
SSHPROXY_HMAC_KEY=

# The did.jump_server row this proxy is. Carried into the decision and the audit
# row; it is what a jump-server-scoped grant would be checked against.
SSHPROXY_JUMP_SERVER_ID=

# Names this proxy in the push prompt and the audit row. An operator approving a
# session should be able to tell which jump box is asking. Defaults to hostname.
SSHPROXY_COMPONENT_NAME=

# ── Appearing in the console ─────────────────────────────────────────────────
#
# Optional, and leaving it unset is a working state: the proxy serves SSH
# perfectly well and simply does not show up in the console. Requiring the
# console to be reachable before SSH works would invert what depends on what.
#
# authnull-service, NOT authn-service. Different service, different port.
SSHPROXY_CONTROL_URL=http://127.0.0.1:8080/api/v1/jumpserver/proxyHeartbeat

# Where finished recordings are shipped. Empty means they stay on this box only:
# still written, still verifiable with tools/cast-viewer.html and VerifyRecording,
# just not listed or playable in the console.
#
# Separate from CONTROL_URL on purpose. A heartbeat is a few fields a minute; this
# carries a whole session transcript when a session ends, and a deployment can
# reasonably want the proxy visible in the console without shipping transcripts
# off the jump box at all.
#
# Reporting happens after the operator has already disconnected, on a queue, and
# every failure is a log line -- a control plane that is down cannot fail, delay
# or block a session. The recording is never deleted after a successful report:
# the jump box keeps the original.
SSHPROXY_RECORDING_URL=http://127.0.0.1:8080/api/v1/jumpserver/ingestRecording

# The shared key co-located services present in place of a user session. Same
# value as INTERNAL_API_KEY in the stack's .env; generated by its install.sh.
# It grants nothing but the heartbeat, which records a timestamp and answers
# nothing back.
SSHPROXY_INTERNAL_API_KEY=

# This gateway's own credentials -- what replaces the shared key above. The
# console issues them per gateway and writes them into console.env when an
# administrator downloads it, so normally you never set them here. The proxy
# exchanges them for a short-lived token; with all three set, the shared key is
# not sent. Re-downloading console.env rotates the secret.
#
# REQUIRED: the proxy refuses to start without all three. They are how it
# fetches each session's grant key (below), and without that key it cannot open
# any target.
# SSHPROXY_TOKEN_URL=https://<console>/api/v1/gateway/token
# SSHPROXY_CLIENT_ID=
# SSHPROXY_CLIENT_SECRET=

# ── How targets are opened ───────────────────────────────────────────────────
#
# Only with policy grant keys. When an SSH policy names a target host AND
# account, the control plane keeps a key for that account in its vault and
# releases it once per approved decision, to this gateway only. That key is the
# only credential the proxy ever presents to a target: there is no shared
# backend key and no CA certificate, so an account no policy grants is refused
# ("no access grant for this account") and nothing is offered to the target.
#
# Each target needs the endpoint reconcile setup script run on it once, so the
# control plane can install and rotate grant keys in the account's
# authorized_keys. root is never granted.
#
# SSHPROXY_BACKEND_KEY_PATH, SSHPROXY_CA_KEY_PATH, SSHPROXY_CERT_HOSTS,
# SSHPROXY_CERT_VALIDITY, SSHPROXY_CERT_DENY_ACCOUNTS, SSHPROXY_SHARED_KEY_HOSTS,
# SSHPROXY_GRANT_ONLY_HOSTS and SSHPROXY_SESSION_GRANT_KEYS are retired: the
# proxy logs that each one still set is ignored, and they can be deleted.

# How often liveness is reported, and therefore the console's resolution for
# "is this proxy up".
# SSHPROXY_HEARTBEAT_SEC=60

# ── Defaults worth knowing ───────────────────────────────────────────────────

# SSHPROXY_LISTEN_ADDR=:2222
# SSHPROXY_HOST_KEY_PATH=/etc/authnull/sshproxy/host_key
# SSHPROXY_KNOWN_HOSTS_PATH=/etc/authnull/sshproxy/known_hosts
# SSHPROXY_SESSION_DIR=/var/authnull/recordings/sshproxy

# Refuses a session whose recording cannot start. Leave it closed in production:
# an unrecorded privileged session is what this product sells against.
# SSHPROXY_FAIL_POLICY=closed

# Refuse a target whose host key is not already pinned, instead of pinning it on
# first use. Worth turning on once every target has been seen once -- the one
# thing trust-on-first-use cannot catch is an interception that arrives before
# the first legitimate session.
# SSHPROXY_KNOWN_HOSTS_STRICT=false

# These three nest, and the order matters: the client's SSH login grace must
# exceed AUTH_TIMEOUT, which must exceed AUTHN_TIMEOUT, which must exceed the
# challenge TTL. Get it wrong and an approval given in time still fails, at
# whichever layer expires first.
# SSHPROXY_AUTH_TIMEOUT_SEC=90
# SSHPROXY_AUTHN_TIMEOUT_SEC=60

# Must be LESS than the unit's TimeoutStopSec, or systemd kills the proxy
# mid-drain and truncates a live recording.
# SSHPROXY_SHUTDOWN_GRACE_SEC=30

# SSHPROXY_MAX_CONCURRENT=64
# SSHPROXY_RECORD_EXEC_IO=false
# SSHPROXY_LOG_LEVEL=info
