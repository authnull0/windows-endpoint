# AuthNull SSH proxy.
#
# Runs on the jump host, NOT in the compose stack. It sits on the
# operator-to-target path, which the containers do not, and it is the only
# Authnull component that holds no database credentials.

[Unit]
Description=AuthNull SSH proxy
Documentation=https://github.com/authnull0/sshproxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=authnull
Group=authnull

# TWO files, and the split is what makes a console-generated config safe to
# copy in wholesale.
#
# sshproxy.env belongs to the INSTALLER. It holds the values it generated --
# SSHPROXY_HMAC_KEY -- and nothing else should overwrite it. A single
# EnvironmentFile meant a downloaded config dropped on top of it destroyed it,
# silently: recordings then have no integrity sidecar, while the proxy starts
# and looks healthy.
#
# console.env belongs to the CONSOLE. Org, tenant, jump-server row, endpoints
# and this gateway's client credentials -- the things only it knows. The proxy
# needs those credentials to fetch each session's grant key, the only key it
# opens a target with. Safe to replace in full, because nothing else writes it.
#
# Optional, hence the leading dash: a proxy configured entirely by hand has no
# such file and must still start. Later files win on conflict, so a value in
# console.env overrides the same key in sshproxy.env.
EnvironmentFile=/etc/authnull/sshproxy/sshproxy.env
EnvironmentFile=-/etc/authnull/sshproxy/console.env
ExecStart=/usr/local/bin/authnull-sshproxy

Restart=on-failure
RestartSec=5s

# MUST exceed SSHPROXY_SHUTDOWN_GRACE_SEC, or systemd sends SIGKILL while the
# proxy is still draining -- which truncates the recording of whatever session
# was live, the exact outcome the drain exists to prevent. Default grace is 30s.
TimeoutStopSec=60s

# ── hardening ────────────────────────────────────────────────────────────────
#
# This process terminates SSH from outside the network and connects onward to
# privileged accounts, so it gets the full set.

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6

# No capabilities at all. The proxy listens on 2222 rather than 22 precisely so
# it never needs CAP_NET_BIND_SERVICE.
CapabilityBoundingSet=
AmbientCapabilities=

# ProtectSystem=strict makes everything read-only, so both writable paths have
# to be named. The recordings directory is obvious. /etc/authnull/sshproxy is
# NOT: known_hosts is appended to when a target is pinned on first use, and
# without this the first connection to every new host fails with a permission
# error that reads like a configuration problem.
ReadWritePaths=/var/authnull/recordings/sshproxy /etc/authnull/sshproxy

[Install]
WantedBy=multi-user.target
